# Puerto en el que corre el servidor (la mayoría de hostings asignan el puerto automáticamente mediante la variable de entorno PORT)
PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS (en desarrollo se permite localhost:4200 de Angular)
ALLOWED_ORIGINS=http://localhost:4200

# Conexión MySQL; crea previamente esta base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=logibox

# Cambia por un secreto aleatorio largo en producción
JWT_SECRET=replace-with-a-long-random-secret
